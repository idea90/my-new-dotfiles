{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 400,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "fit-to-screen": true,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 140,
  "notification-body-image-width": 200,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "relative-timestamps": true,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "buttons-grid",
    "volume",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "󰝟",
          "type": "toggle",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰍭",
          "type": "toggle",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰊗",
          "type": "toggle",
          "command": "~/.config/hypr/scripts/gamemode.sh",
          "update-command": "sh -c '[ -f ~/.cache/gamemode ] && echo true || echo false'"
        },
        {
          "label": "󰆞",
          "command": "sh -c 'swaync-client -cp; sleep 0.3; ~/.config/hypr/scripts/screenshot.sh --area'"
        },
        {
          "label": "󰏘",
          "command": "sh -c 'swaync-client -cp; ~/.config/hypr/scripts/apply-wal'"
        },
        {
          "label": "󰒓",
          "command": "sh -c 'swaync-client -cp; nwg-look'"
        },
        {
          "label": "󰌾",
          "command": "sh -c 'swaync-client -cp; loginctl lock-session'"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 8
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    }
  }
}
