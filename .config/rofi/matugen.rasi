/* Semantic colors for the rofi themes. Raw palette comes from colors.rasi (matugen). */
* {
    bg:          @surface;
    bg-alt:      @surface-container;
    bg-hover:    @surface-container-high;
    fg:          @on-surface;
    fg-dim:      @on-surface-variant;
    accent:      @primary;
    on-accent:   @on-primary;
    accent-soft: @primary-container;
    on-soft:     @on-primary-container;
    border:      @outline-variant;
    urgent:      @error;
    on-urgent:   @on-error;

    background-color: transparent;
    text-color:       @fg;
}
