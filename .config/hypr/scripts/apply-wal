#!/usr/bin/env bash
#
# Wallpaper + theme backend. The picker UI is Quickshell
# (~/.config/quickshell/wallpaper); this script does the work.
#
#   apply-wal                 open the picker (Super+W)
#   apply-wal --list          make missing thumbnails, print name<TAB>path<TAB>thumb, newest first
#   apply-wal --apply PATH    set wallpaper with awww and regenerate colors with matugen
#   apply-wal --random        apply a random wallpaper
#   apply-wal --mode dark|light|toggle
#   apply-wal --scheme scheme-tonal-spot|scheme-content|...
#   apply-wal --reapply       regenerate colors for the current wallpaper
#
# Dependencies: awww, matugen, imagemagick, libnotify

SCRIPT_PATH="$(cd -- "$(dirname "$0")" >/dev/null 2>&1 && pwd -P)"

WALLPAPERS_DIR="${WALLPAPERS_DIR:-$HOME/wallpapers}"
THUMBS_DIR="$HOME/.cache/wallpaper-thumbs"
CURRENT_WALLPAPER_FILE="$HOME/.cache/current_wallpaper"
LOCK_IMAGE="$HOME/.cache/lockscreen.png"   # sharp PNG, hyprlock blurs it itself
ENV_FILE="$SCRIPT_PATH/.env"

# shellcheck source=/dev/null
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
MODE="${MODE:-dark}"
TYPE="${TYPE:-scheme-tonal-spot}"

mkdir -p "$WALLPAPERS_DIR" "$THUMBS_DIR"

save_env() {
    printf 'MODE=%s\nTYPE=%s\n' "$MODE" "$TYPE" > "$ENV_FILE"
}

# Wallpaper file names, newest first
list_images() {
    find "$WALLPAPERS_DIR" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) \
        -printf '%T@ %f\n' | sort -rn | cut -d' ' -f2-
}

thumb_of() { printf '%s/%s.png' "$THUMBS_DIR" "$1"; }

# Run image work in the background without making the desktop stutter:
# lowest CPU and disk priority, one ImageMagick thread per process
gentle() {
    MAGICK_THREAD_LIMIT=1 nice -n 19 ionice -c 3 "$@"
}

# Square thumbnails for the picker, rebuilt when the source changes.
# jpeg:size lets JPEGs decode at reduced size (several times faster); at most
# half the cores are used, so the desktop keeps running smoothly.
make_thumbs() {
    local name missing=()
    while IFS= read -r name; do
        [[ "$(thumb_of "$name")" -nt "$WALLPAPERS_DIR/$name" ]] || missing+=("$name")
    done
    (( ${#missing[@]} )) || return 0
    local jobs=$(( $(nproc) / 2 ))
    (( jobs >= 1 )) || jobs=1
    export MAGICK_THREAD_LIMIT=1
    printf '%s\0' "${missing[@]}" | gentle xargs -0 -P "$jobs" -I{} \
        magick -define jpeg:size=800x600 "$WALLPAPERS_DIR/{}[0]" -thumbnail '400x300^' -gravity center \
        -extent 400x300 "$THUMBS_DIR/{}.png"
}

list() {
    local names name
    names="$(list_images)"
    [[ -n "$names" ]] || return 0
    printf '%s\n' "$names" | make_thumbs
    while IFS= read -r name; do
        printf '%s\t%s\t%s\n' "$name" "$WALLPAPERS_DIR/$name" "$(thumb_of "$name")"
    done <<< "$names"
}

apply_wallpaper() {
    local wallpaper="$1"
    [[ -f "$wallpaper" ]] || { notify-send -a Wallpaper "Wallpaper not found" "$wallpaper"; exit 1; }
    echo "$wallpaper" > "$CURRENT_WALLPAPER_FILE"

    # Colors may be missing on a fresh install; create a starter set first
    "$SCRIPT_PATH/seed-colors.sh" >/dev/null 2>&1

    # Show the new wallpaper right away, then recolor everything
    awww img "$wallpaper" --transition-type center
    if ! matugen image "$wallpaper" -m "$MODE" -t "$TYPE" --source-color-index 0; then
        notify-send -a Wallpaper -u critical "Failed to generate colors"
        exit 1
    fi
    gentle magick -define jpeg:size=2560x2560 "$wallpaper[0]" -resize "2560x2560>" "$LOCK_IMAGE"
    # Login screen follows too (no-op unless the sddm theme is installed)
    gentle "$SCRIPT_PATH/sddm-theme" sync >/dev/null 2>&1 &
    notify-send -a Wallpaper -i "$(thumb_of "$(basename "$wallpaper")")" "Theme updated" "$(basename "$wallpaper") · $MODE · ${TYPE#scheme-}"
}

reapply() {
    local current
    current="$(cat "$CURRENT_WALLPAPER_FILE" 2>/dev/null)"
    if [[ -f "$current" ]]; then
        apply_wallpaper "$current"
    else
        notify-send -a Wallpaper "Pick a wallpaper first" "Super+W"
    fi
}

random_wallpaper() {
    local name
    name="$(list_images | shuf -n 1)"
    [[ -n "$name" ]] && apply_wallpaper "$WALLPAPERS_DIR/$name"
}

case "${1:-}" in
    --list)
        list
        ;;
    --apply)
        apply_wallpaper "${2:?usage: apply-wal --apply PATH}"
        ;;
    --random)
        random_wallpaper
        ;;
    --mode)
        case "${2:-toggle}" in
            dark|light) MODE="$2" ;;
            *) [[ "$MODE" == dark ]] && MODE=light || MODE=dark ;;
        esac
        save_env
        "$SCRIPT_PATH/gtk-settings.sh" "$MODE"
        reapply
        ;;
    --scheme)
        TYPE="${2:?usage: apply-wal --scheme scheme-NAME}"
        save_env
        reapply
        ;;
    --reapply)
        reapply
        ;;
    "")
        qs ipc call wallpaper toggle
        ;;
    *)
        sed -n '2,15p' "$0" >&2
        exit 1
        ;;
esac
