/**
 * App launcher (Super+D). Colors from matugen via colors.rasi + matugen.rasi.
 * Other menus (wallpaper, dmenu) import this file and override pieces.
 */

configuration {
    modi:                  "drun,run,window";
    show-icons:            true;
    icon-theme:            "Papirus-Dark";
    terminal:              "alacritty";
    drun-display-format:   "{name}";
    window-format:         "{c} · {t}";
    display-drun:          "Apps";
    display-run:           "Run";
    display-window:        "Windows";
    matching:              "fuzzy";
    sort:                  true;
    sorting-method:        "fzf";
    disable-history:       false;
    hover-select:          true;
    me-select-entry:       "";
    me-accept-entry:       "MousePrimary";
    kb-cancel:             "Escape,Control+g,Control+bracketleft";
}

@import "colors.rasi"
@import "matugen.rasi"
@import "fonts.rasi"

window {
    location:         center;
    anchor:           center;
    width:            560px;
    transparency:     "real";
    border:           1px solid;
    border-color:     @border;
    border-radius:    12px;
    background-color: @bg;
}

mainbox {
    padding:  14px;
    spacing:  10px;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
}

/* Search bar */
inputbar {
    padding:          10px 14px;
    spacing:          10px;
    border-radius:    8px;
    background-color: @bg-alt;
    children:         [ "prompt", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search";
    placeholder-color: @fg-dim;
    cursor:            text;
}

num-filtered-rows, num-rows {
    expand:     false;
    text-color: @fg-dim;
}

textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: @fg-dim;
}

/* Results */
listview {
    lines:        8;
    columns:      1;
    spacing:      2px;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    fixed-height: true;
}

element {
    padding:       8px 10px;
    spacing:       12px;
    border-radius: 8px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    text-color: @fg;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element selected.normal,
element selected.active {
    background-color: @accent;
    text-color:       @on-accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @on-urgent;
}

element-icon {
    size:       24px;
    cursor:     inherit;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    highlight:      bold underline;
    cursor:         inherit;
    text-color:     inherit;
}

/* Bottom tabs: Apps / Run / Windows */
mode-switcher {
    spacing: 6px;
}

button {
    padding:          6px;
    border-radius:    8px;
    background-color: @bg-alt;
    text-color:       @fg-dim;
    cursor:           pointer;
}

button selected {
    background-color: @accent-soft;
    text-color:       @on-soft;
}

/* Messages and errors */
message {
    padding:          10px 14px;
    border-radius:    8px;
    background-color: @bg-alt;
}

textbox {
    text-color:     @fg;
    vertical-align: 0.5;
}

error-message {
    padding:          14px;
    border:           1px solid;
    border-color:     @urgent;
    border-radius:    12px;
    background-color: @bg;
    text-color:       @fg;
}
